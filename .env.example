# Copy this file to .env and fill in values for your on-premise environment.
# .env is gitignored — never commit real credentials.

# --- Local AI (Ollama) — used for dynamic narratives (Score Deficit Alerts, Event Summaries) ---
# Falls back to a deterministic rule-based text generator automatically if unreachable.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# --- Survey Upload Reminder Emails (internal/on-premise SMTP relay only) ---
# If SMTP_HOST is left empty, reminders are still computed and logged to the server console,
# but no email is sent (the app never fails because of a missing/misconfigured mail server).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=people-experience@cimbniaga.co.id

# --- Reminder e-mail sender ---
# Configure it in the app: Header > "Setting Email" (stored in the database, password encrypted).
# SETTINGS_ENCRYPTION_KEY (AES-256 key, 64 hex chars) is generated automatically on first use and
# appended to .env — keep it with your database backups, or the stored SMTP password can't be decrypted.
# SETTINGS_ENCRYPTION_KEY=

# --- Backend port (do not let this collide with Vite's port 3000) ---
PORT=5000

# --- Event video AI transcript (Signature Program Events → Photo Gallery) ---
# Local audio/video-to-text API (faster-whisper "Video Extractor"). The uploaded video's
# LOCAL file path is sent to it, so media never leaves this machine. Language defaults to "id".
TRANSCRIBE_API_URL=http://127.0.0.1:8000
TRANSCRIBE_LANGUAGE=id
# Max seconds-in-ms to wait for one transcription (default 30 min) and max upload size in MB.
TRANSCRIBE_TIMEOUT_MS=1800000
MEDIA_MAX_MB=200

# --- Storage backend ---
# json (default) = local file store server/data/store.json
# sql            = Microsoft SQL Server (all dashboard data is read from / written to the DB)
# Rollback at any time: set STORAGE_BACKEND=json (or remove the line) and restart the server.
STORAGE_BACKEND=json

# sql backend only: keep adding generated DEMO survey responses for each new month (true), or
# never generate synthetic data (false — use on a real production database).
SEED_DEMO_DATA=true

# --- Microsoft SQL Server (only used when STORAGE_BACKEND=sql) ---
# scripts/sqlserver/Setup-SqlServer.ps1 installs SQL Server Express and writes these for you.
# The app logs in as a dedicated least-privilege login (db_owner of this database only), never sa.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=PeopleExperiencePX
DB_USER=px_app
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
