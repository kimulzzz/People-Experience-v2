# Copy this file to .env and fill in values for your on-premise environment.
# .env is gitignored — never commit real credentials.

# --- Local AI (Ollama) — since v2.28.0 used ONLY for the AI Summary of event videos (transcript -> summary) ---
# Recommended model: gemma3:4b (the code default when OLLAMA_MODEL is unset) -> `ollama pull gemma3:4b`.
# Falls back to a deterministic rule-based summary automatically if Ollama is unreachable.
# Time limits (default 120 minutes = 7200000 ms): OLLAMA_TIMEOUT_MS = one Gemma call, SUMMARY_JOB_TIMEOUT_MS = the whole
# summary job (all parts + retry). AI_QUEUE_MAX (default 50). Leave unset to keep the defaults.
# OLLAMA_TIMEOUT_MS=7200000
# SUMMARY_JOB_TIMEOUT_MS=7200000
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Survey Upload Reminder Emails (internal/on-premise SMTP relay only) ---
# If SMTP_HOST is left empty, reminders are still computed and logged to the server console,
# but no email is sent (the app never fails because of a missing/misconfigured mail server).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=people-experience@cimbniaga.co.id

# --- Reminder e-mail sender ---
# Configure it in the app: Header > "Email Settings" (stored in the database, password encrypted).
# SETTINGS_ENCRYPTION_KEY (AES-256 key, 64 hex chars) is generated automatically on first use and
# appended to .env — keep it with your database backups, or the stored SMTP password can't be decrypted.
# Since v2.61.1 a key set in the environment may also be base64 of 32 bytes (what Render's generateValue produces);
# surrounding blanks are ignored. A set but invalid value is reported once at startup (never printed) and ignored.
# SETTINGS_ENCRYPTION_KEY=

# --- Standard initial password (optional) ---
# If set, new accounts, reset-password and `npm run auth:create-admin` use this instead of a random temporary
# password (the account must still change it at first login). Empty = random. Anyone who knows it can enter an
# account until its owner logs in for the first time - change it right away.
# DEFAULT_INITIAL_PASSWORD=

# --- Bootstrap Admin for hosts without a shell (v2.61.1, e.g. Render UAT; see docs/06 "Deploy UAT ke Render") ---
# If BOOTSTRAP_ADMIN_USERNAME is set and there is NO active Admin, the server creates one Admin at startup with the
# password DEFAULT_INITIAL_PASSWORD (required; must be changed at first sign-in). Never promotes or reactivates an
# existing account. Remove both variables once the first Admin has changed the password. Leave empty on-premise
# (use `npm run auth:create-admin` there).
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_NAME=Administrator PX
# BOOTSTRAP_ADMIN_EMAIL=

# --- Backend port (do not let this collide with Vite's port 3000) ---
PORT=5000

# --- Event video AI transcript (Signature Program Events → Photo Gallery) ---
# Local audio/video-to-text API (faster-whisper "Video Extractor"). The uploaded video's
# LOCAL file path is sent to it, so media never leaves this machine. Language defaults to "id".
TRANSCRIBE_API_URL=http://127.0.0.1:8000
TRANSCRIBE_LANGUAGE=id
# Max time in ms to wait for one transcription (default 120 minutes = 7200000) and max upload size in MB.
# REQUEST_TIMEOUT_MS (default 7200000) is how long the server waits for ONE whole upload request (Node's own default is 5 min).
TRANSCRIBE_TIMEOUT_MS=7200000
# Since v2.59.0 the photo/video upload limit is the Admin setting media_upload_max_mb (Admin Parameters ->
# Journey Parameters -> Upload Limits, default 1024 MB). MEDIA_MAX_MB is only the fallback when that setting cannot be read.
MEDIA_MAX_MB=200

# --- Storage backend ---
# json (default) = local file store server/data/store.json
# sql            = Microsoft SQL Server (all dashboard data is read from / written to the DB) - on-premise production
# pg             = PostgreSQL 15+ (v2.61.0, same code through server/db/dialects/pg.js) - temporary UAT hosting, DUMMY data only
# Rollback at any time: set STORAGE_BACKEND=json (or remove the line) and restart the server.
STORAGE_BACKEND=json

# sql backend only: keep adding generated DEMO survey responses for each new month (true), or
# never generate synthetic data (false — use on a real production database).
SEED_DEMO_DATA=true

# --- Microsoft SQL Server (only used when STORAGE_BACKEND=sql) ---
# scripts/sqlserver/Setup-SqlServer.ps1 installs SQL Server Express and writes these for you.
# The app logs in as a dedicated least-privilege login (db_owner of this database only), never sa.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=PeopleExperiencePX
DB_USER=px_app
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- PostgreSQL (only used when STORAGE_BACKEND=pg, v2.61.0; see docs/08 section 33) ---
# Either DATABASE_URL (e.g. Render) or the PG_* values below. PG_SSL=1 = TLS without certificate check (Render's external
# URL). Do NOT append ?sslmode=require to DATABASE_URL - it overrides PG_SSL and pg 8 then verifies the certificate fully.
# The database role must be allowed to CREATE EXTENSION citext (schema.pg.sql creates it).
# DATABASE_URL=
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=
# PG_PASSWORD=
# PG_DATABASE=peopleexperiencepx
# PG_SSL=0
# PG_POOL_MAX=10
