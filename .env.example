# Copy this file to .env and fill in values for your on-premise environment.
# .env is gitignored — never commit real credentials.

# --- Local AI (Ollama) — used for dynamic narratives (Score Deficit Alerts, Event Summaries) ---
# Falls back to a deterministic rule-based text generator automatically if unreachable.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# --- Survey Upload Reminder Emails (internal/on-premise SMTP relay only) ---
# If SMTP_HOST is left empty, reminders are still computed and logged to the server console,
# but no email is sent (the app never fails because of a missing/misconfigured mail server).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=people-experience@cimbniaga.co.id

# --- Backend port (do not let this collide with Vite's port 3000) ---
PORT=5000

# --- Event video AI transcript (Signature Program Events → Photo Gallery) ---
# Local audio/video-to-text API (faster-whisper "Video Extractor"). The uploaded video's
# LOCAL file path is sent to it, so media never leaves this machine. Language defaults to "id".
TRANSCRIBE_API_URL=http://127.0.0.1:8000
TRANSCRIBE_LANGUAGE=id
# Max seconds-in-ms to wait for one transcription (default 30 min) and max upload size in MB.
TRANSCRIBE_TIMEOUT_MS=1800000
MEDIA_MAX_MB=200
